# Force LF line endings for all text files in the repo.
# Without this, `actions/checkout@v4` on windows-latest converts LF → CRLF
# on checkout, which breaks `biome format --check` (configured for LF).
* text=auto eol=lf

# Explicit overrides for files that must be binary or have specific EOL.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.tar binary
*.lockb binary

{
  "name": "@juanfranem/opencode-auto-guard",
  "version": "0.1.5",
  "description": "Multi-layer guard plugin for OpenCode v2 — stops dangerous shell commands, web requests, and file edits before the agent runs them.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "security",
    "permissions",
    "judge",
    "ai-agent",
    "prompt-injection",
    "shell-guard",
    "codeql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juanfranem/opencode-auto-guard.git"
  },
  "homepage": "https://github.com/juanfranem/opencode-auto-guard#readme",
  "bugs": {
    "url": "https://github.com/juanfranem/opencode-auto-guard/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "test": "bun src/tests/evasion-test.ts && bun src/tests/compact-test.ts && bun src/tests/agent-registration-test.ts && bun src/tests/jev-test.ts && bun src/tests/env-placeholder-test.ts",
    "test:evasion": "bun src/tests/evasion-test.ts",
    "test:compact": "bun src/tests/compact-test.ts",
    "test:agent-registration": "bun src/tests/agent-registration-test.ts",
    "test:jev": "bun src/tests/jev-test.ts",
    "test:env-placeholder": "bun src/tests/env-placeholder-test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "audit": "bun audit"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.0"
  },
  "overrides": {
    "@opentelemetry/core": ">=2.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  },
  "files": [
    "src/index.ts",
    "src/rules.ts",
    "src/judge-fast.ts",
    "src/agent-registration.ts",
    "agents",
    "assets",
    "README.md",
    "LICENSE",
    "docs"
  ]
}
